node_modules/
# and as a bare entry too: a git worktree is set up with node_modules as a
# SYMLINK, which the trailing-slash rule above does not match, so without this
# line the symlink shows as untracked and can be committed into the package.
node_modules
.env
.env.local
*.log
.DS_Store

# Built MCPB bundles. `npm run bundle` writes one at the repo root; it is a
# 3MB build artifact rebuilt from source on demand, never a committed file.
*.mcpb
// gitignored: needs a workflow-scoped token to push; add via GitHub UI later
.github/workflows/

